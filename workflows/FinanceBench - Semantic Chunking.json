      "parameters": {
        "jsCode": "\nconst text = $input.first().json.text;\n\nif (typeof text !== 'string' || text.length === 0) {\n  throw new Error('No extracted PDF text found');\n}\n\nconst batchSize = 6000;\nconst result = [];\n\nfor (let start = 0; start < text.length; start += batchSize) {\n  result.push({\n    json: {\n      sample_text: text.slice(start, start + batchSize),\n      batch_number: result.length + 1,\n      source: '3M_2018_10K.pdf'\n    }\n  });\n}\n\n\nreturn result;\n"
      },
